+    // ---- dlssg-open: CUDA fatbin PTX retargeting -------------------------------------------------
+    // NVIDIA's DLSS-G runtime ships kernels as fatbins holding ELF sm_89 + LZ4 PTX ".target sm_89".
+    // The driver refuses PTX targeting a higher SM than the device.  When DXVK_NVAPI_CUBIN_RETARGET_SM
+    // (e.g. "86") is set the fatbin is copied and the ".target sm_NN" literal inside each PTX entry
+    // is rewritten (its first occurrence is a literal in the LZ4 stream), plus the entry's arch field.
+    // The driver then skips the incompatible ELF and JIT-compiles the retargeted PTX.
+    static int retargetSm() {
+        static int sm = [] {
+            auto v = env::getEnvVariable("DXVK_NVAPI_CUBIN_RETARGET_SM");
+            return v.empty() ? 0 : std::atoi(v.c_str());
+        }();
+        return sm;
+    }
+
