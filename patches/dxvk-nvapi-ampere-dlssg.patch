+    // dlssg-open: name of the module that contains pReturnAddress (lower-case basename), or "".
+    static std::string callerModuleName(void* pReturnAddress) {
+        char modulePath[MAX_PATH];
+        HMODULE hModule = nullptr;
+        if (!pReturnAddress || !GetModuleHandleEx(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT, static_cast<const char*>(pReturnAddress), &hModule))
+            return "";
+        uint32_t pathLen = GetModuleFileName(hModule, modulePath, MAX_PATH);
+        if (!pathLen) return "";
+        std::string p(modulePath, pathLen);
+        auto slash = p.find_last_of("\\/");
+        std::string base = slash == std::string::npos ? p : p.substr(slash + 1);
+        std::for_each(base.begin(), base.end(), [](char& ch) { ch = std::tolower(ch, std::locale::classic()); });
+        return base;
+    }
+
+    // dlssg-open: DXVK_NVAPI_GPU_ARCH_CALLERS="sl.dlss_g.dll,sl.common.dll" restricts DXVK_NVAPI_GPU_ARCH to
+    // those calling modules; every other caller sees the real architecture.
+    static bool archOverrideAppliesToCaller(void* pReturnAddress) {
+        static const std::string callers = [] {
+            auto v = env::getEnvVariable("DXVK_NVAPI_GPU_ARCH_CALLERS");
+            std::for_each(v.begin(), v.end(), [](char& ch) { ch = std::tolower(ch, std::locale::classic()); });
+            return v;
+        }();
+        auto name = callerModuleName(pReturnAddress);
+        if (callers.empty()) {
+            log::info(str::format("GetArchInfo caller: ", name.empty() ? "(unknown)" : name, " (override applies to all callers)"));
+            return true;
+        }
+        bool match = !name.empty() && (("," + callers + ",").find("," + name + ",") != std::string::npos);
+        log::info(str::format("GetArchInfo caller: ", name.empty() ? "(unknown)" : name, match ? " -> spoofed" : " -> real architecture"));
+        return match;
+    }
