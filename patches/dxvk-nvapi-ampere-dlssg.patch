+    std::optional<std::vector<uint8_t>> NvapiD3d12Device::RetargetFatbin(const void* data, uint32_t size) {
+        auto sm = retargetSm();
+        if (sm < 10 || sm > 99 || !data || size < 16)
+            return std::nullopt;
+
+        auto src = static_cast<const uint8_t*>(data);
+        uint32_t magic; std::memcpy(&magic, src, 4);
+        uint16_t ver; std::memcpy(&ver, src + 4, 2);
+        uint16_t hdr; std::memcpy(&hdr, src + 6, 2);
+        if (magic != 0xBA55ED50u || ver != 1 || hdr != 16) {
+            log::info(str::format("Cubin upload: not a fatbin (magic ", magic, ", size ", size, ")"));
+            return std::nullopt;
+        }
+        {
+            std::string desc;
+            size_t q = hdr;
+            while (q + 64 <= size) {
+                uint16_t k; std::memcpy(&k, src + q, 2);
+                uint32_t hs; std::memcpy(&hs, src + q + 4, 4);
+                uint64_t pd; std::memcpy(&pd, src + q + 8, 8);
+                uint32_t ar; std::memcpy(&ar, src + q + 28, 4);
+                if ((k != 1 && k != 2) || hs < 64 || q + hs + pd > size) break;
+                desc += (k == 1 ? " ptx" : " elf") + std::string("_sm") + std::to_string(ar);
+                q += hs + pd;
+            }
+            log::info(str::format("Cubin upload: fatbin size ", size, " entries:", desc));
+        }
+
+        std::vector<uint8_t> buf(src, src + size);
+        char want[16]; std::snprintf(want, sizeof(want), ".target sm_%d", sm);
+        const std::string wantStr(want);
+        bool changed = false;
+        size_t p = hdr;
+        while (p + 64 <= buf.size()) {
+            uint16_t kind; std::memcpy(&kind, &buf[p], 2);
+            uint32_t hsz; std::memcpy(&hsz, &buf[p + 4], 4);
+            uint64_t padded; std::memcpy(&padded, &buf[p + 8], 8);
+            uint32_t real; std::memcpy(&real, &buf[p + 16], 4);
+            uint32_t arch; std::memcpy(&arch, &buf[p + 28], 4);
+            if ((kind != 1 && kind != 2) || hsz < 64 || p + hsz + padded > buf.size())
+                break;
+            if (kind == 1 && arch > static_cast<uint32_t>(sm) && arch < 100) {
+                auto begin = buf.begin() + p + hsz;
+                auto end = begin + std::min<uint64_t>(real, padded);
+                const std::string needle = ".target sm_" + std::to_string(arch);
+                auto it = std::search(begin, end, needle.begin(), needle.end());
+                if (it != end) {
+                    std::copy(wantStr.begin(), wantStr.end(), it);
+                    uint32_t a = sm; std::memcpy(&buf[p + 28], &a, 4);
+                    changed = true;
+                    log::info(str::format("Retargeted fatbin PTX entry sm_", arch, " -> sm_", sm));
+                } else {
+                    log::info(str::format("Fatbin PTX entry sm_", arch, ": '.target' literal not found, left untouched"));
+                }
+            }
+            p += hsz + padded;
+        }
+        if (!changed)
+            return std::nullopt;
+        return buf;
+    }
+
+
+    // ---- dlssg-open: raw ELF cubin substitution --------------------------------------------------
+    // The DLSS-G 310.x runtime uploads its neural-network kernels as bare ELF cubins (SASS only) and
+    // picks the sm_89 build because NVAPI reports Ada.  The same DLL embeds an sm_86 build of every
+    // one of those kernels.  When a bare cubin arrives whose SM is above DXVK_NVAPI_CUBIN_RETARGET_SM,
+    // the runtime DLL is read from disk, its sm_<target> cubins indexed, the twin chosen (same kernel
+    // name, same .text size, same constant banks, highest per-instruction equality), the
+    // runtime's .nv.shared size copied onto it, and the twin handed to the driver instead.
+    namespace elf {
+        struct Cubin {
+            std::vector<uint8_t> data;
+            uint32_t sm = 0;
+            std::string kernel;
+            size_t textOff = 0, textSize = 0;
+            std::vector<uint8_t> c2;
+            size_t c0Size = 0;
+            int sharedShdr = -1;   // index of .nv.shared.<k> section header
+            int rwPhdr = -1;       // index of RW PT_LOAD
+        };
+
+        static bool parse(const uint8_t* d, size_t n, Cubin& out) {
+            if (n < 64 || std::memcmp(d, "\x7f" "ELF", 4) != 0 || d[4] != 2) return false;
+            uint16_t machine; std::memcpy(&machine, d + 18, 2);
+            if (machine != 190) return false;
+            uint32_t flags; std::memcpy(&flags, d + 48, 4);
+            uint64_t phoff, shoff; std::memcpy(&phoff, d + 32, 8); std::memcpy(&shoff, d + 40, 8);
+            uint16_t phentsize, phnum, shentsize, shnum, shstrndx;
+            std::memcpy(&phentsize, d + 54, 2); std::memcpy(&phnum, d + 56, 2);
+            std::memcpy(&shentsize, d + 58, 2); std::memcpy(&shnum, d + 60, 2); std::memcpy(&shstrndx, d + 62, 2);
+            size_t end = std::max<size_t>(shoff + size_t(shentsize) * shnum, phoff + size_t(phentsize) * phnum);
+            if (end > n || shstrndx >= shnum || shentsize < 64) return false;
+            auto sh = [&](int i, int field) { uint64_t v; std::memcpy(&v, d + shoff + size_t(i) * shentsize + field, 8); return v; };
+            auto sh32 = [&](int i, int field) { uint32_t v; std::memcpy(&v, d + shoff + size_t(i) * shentsize + field, 4); return v; };
+            uint64_t strOff = sh(shstrndx, 24), strSize = sh(shstrndx, 32);
+            if (strOff + strSize > n) return false;
+            out.data.assign(d, d + end);
+            out.sm = flags & 0xff;
+            for (int i = 0; i < shnum; i++) {
+                uint32_t nameIdx = sh32(i, 0);
+                if (nameIdx >= strSize) continue;
+                std::string name(reinterpret_cast<const char*>(d + strOff + nameIdx));
+                uint64_t off = sh(i, 24), size = sh(i, 32);
+                if (name.rfind(".text.", 0) == 0 && out.kernel.empty()) { out.kernel = name.substr(6); out.textOff = off; out.textSize = size; }
+                else if (name.rfind(".nv.constant2.", 0) == 0 && off + size <= n) out.c2.assign(d + off, d + off + size);
+                else if (name.rfind(".nv.constant0.", 0) == 0) out.c0Size = size;
+                else if (name.rfind(".nv.shared.", 0) == 0) out.sharedShdr = i;
+            }
+            for (int i = 0; i < phnum; i++) {
+                uint32_t type, pflags; std::memcpy(&type, d + phoff + size_t(i) * phentsize, 4); std::memcpy(&pflags, d + phoff + size_t(i) * phentsize + 4, 4);
+                if (type == 1 && (pflags & 2) && !(pflags & 1)) out.rwPhdr = i;   // PT_LOAD, W, not X
+            }
+            return !out.kernel.empty() && out.textOff + out.textSize <= n;
+        }
+
+        static uint64_t sharedSize(const Cubin& c) {
+            if (c.sharedShdr < 0) return 0;
+            uint64_t shoff; std::memcpy(&shoff, c.data.data() + 40, 8);
+            uint16_t shentsize; std::memcpy(&shentsize, c.data.data() + 58, 2);
+            uint64_t v; std::memcpy(&v, c.data.data() + shoff + size_t(c.sharedShdr) * shentsize + 32, 8); return v;
+        }
+
+        static void setSharedSize(Cubin& c, uint64_t v) {
+            if (c.sharedShdr < 0) return;
+            uint64_t shoff; std::memcpy(&shoff, c.data.data() + 40, 8);
+            uint16_t shentsize; std::memcpy(&shentsize, c.data.data() + 58, 2);
+            std::memcpy(c.data.data() + shoff + size_t(c.sharedShdr) * shentsize + 32, &v, 8);
+            if (c.rwPhdr >= 0) {
+                uint64_t phoff; std::memcpy(&phoff, c.data.data() + 32, 8);
+                uint16_t phentsize; std::memcpy(&phentsize, c.data.data() + 54, 2);
+                std::memcpy(c.data.data() + phoff + size_t(c.rwPhdr) * phentsize + 40, &v, 8);   // p_memsz
+            }
+        }
+
+        static double score(const Cubin& a, const Cubin& b) {
+            if (a.textSize != b.textSize || a.textSize == 0) return 0.0;
+            size_t chunks = a.textSize / 16, eq = 0;
+            for (size_t i = 0; i < chunks; i++)
+                if (std::memcmp(a.data.data() + a.textOff + i * 16, b.data.data() + b.textOff + i * 16, 16) == 0) eq++;
+            return chunks ? double(eq) / double(chunks) : 0.0;
+        }
+    }
+
+    static std::mutex g_twinMutex;
+    static std::vector<elf::Cubin> g_twins;
+    static bool g_twinsLoaded = false;
+
+    static void loadTwins(int targetSm) {
+        std::scoped_lock lock(g_twinMutex);
+        if (g_twinsLoaded) return;
+        g_twinsLoaded = true;
+        const char* candidates[] = {"nvngx_dlssg.dll", "nvngx_dlss.dll"};
+        for (auto modName : candidates) {
+            HMODULE h = GetModuleHandleA(modName);
+            if (!h) continue;
+            char path[MAX_PATH];
+            if (!GetModuleFileNameA(h, path, MAX_PATH)) continue;
+            FILE* f = std::fopen(path, "rb");
+            if (!f) { log::info(str::format("Cubin twins: cannot open ", path)); continue; }
+            std::vector<uint8_t> file;
+            std::fseek(f, 0, SEEK_END); long len = std::ftell(f); std::fseek(f, 0, SEEK_SET);
+            if (len > 0) { file.resize(len); if (std::fread(file.data(), 1, len, f) != size_t(len)) file.clear(); }
+            std::fclose(f);
+            size_t found = 0;
+            for (size_t i = 0; i + 64 <= file.size(); i++) {
+                if (file[i] != 0x7f || std::memcmp(&file[i], "\x7f" "ELF", 4) != 0) continue;
+                elf::Cubin c;
+                if (elf::parse(file.data() + i, file.size() - i, c) && int(c.sm) == targetSm) { g_twins.push_back(std::move(c)); found++; }
+            }
+            log::info(str::format("Cubin twins: indexed ", found, " sm_", targetSm, " cubins from ", path));
+        }
+    }
+
+    static std::optional<std::vector<uint8_t>> SubstituteCubin(const void* data, uint32_t size) {
+        auto sm = retargetSm();
+        if (sm < 10 || sm > 99 || !data || size < 64) return std::nullopt;
+        elf::Cubin up;
+        if (!elf::parse(static_cast<const uint8_t*>(data), size, up)) return std::nullopt;
+        if (int(up.sm) <= sm) return std::nullopt;
+        loadTwins(sm);
+        std::scoped_lock lock(g_twinMutex);
+        const elf::Cubin* best = nullptr; double bestScore = -1; int strictCount = 0;
+        for (auto& t : g_twins) {
+            if (t.kernel != up.kernel) continue;
+            bool strict = t.textSize == up.textSize && t.c2 == up.c2 && t.c0Size == up.c0Size;
+            if (strict) strictCount++;
+            double s = elf::score(up, t) + (strict ? 1.0 : 0.0);
+            if (s > bestScore) { bestScore = s; best = &t; }
+        }
+        if (!best) {
+            log::info(str::format("Cubin substitute: no sm_", sm, " twin for '", up.kernel, "' (sm_", up.sm, ", size ", size, ")"));
+            return std::nullopt;
+        }
+        elf::Cubin twin = *best;
+        uint64_t shared = elf::sharedSize(up);
+        if (shared) elf::setSharedSize(twin, shared);
+        log::info(str::format("Cubin substitute: '", up.kernel, "' sm_", up.sm, " size ", size, " -> sm_", twin.sm, " twin size ", twin.data.size(), " (score ", bestScore, ", strict candidates ", strictCount, ", shared ", shared, ")"));
+        return twin.data;
+    }
