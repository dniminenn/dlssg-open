+    // dlssg-open: DXVK_NVAPI_CUBIN_DUMP_DIR=<dir> writes every uploaded cubin/fatbin to disk for analysis.
+    static void dumpCubin(const void* data, uint32_t size, const char* name) {
+        static const std::string dir = env::getEnvVariable("DXVK_NVAPI_CUBIN_DUMP_DIR");
+        if (dir.empty() || !data || !size) return;
+        static std::atomic<int> seq{0};
+        int n = seq++;
+        std::string fname = dir + "\\" + std::to_string(n) + "_" + (name ? name : "noname") + ".bin";
+        FILE* f = std::fopen(fname.c_str(), "wb");
+        if (!f) return;
+        std::fwrite(data, 1, size, f);
+        std::fclose(f);
+    }
